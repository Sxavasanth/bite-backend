# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/bite_db

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS — set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:3000

# Stripe (optional for now)
STRIPE_SECRET_KEY=sk_test_...
